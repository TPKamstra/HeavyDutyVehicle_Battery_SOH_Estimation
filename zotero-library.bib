	publisher = {Springer International Publishing},
	author = {Roda, Irene and Macchi, Marco and Fumagalli, Luca},
	editor = {Moon, Ilkyeong and Lee, Gyu M. and Park, Jinwoo and Kiritsis, Dimitris and Von Cieminski, Gregor},
	year = {2018},
	note = {Series Title: IFIP Advances in Information and Communication Technology},
	pages = {39--46},
}

