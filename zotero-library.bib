@inproceedings{yangLithiumionBatterySOH2019,
	address = {Auckland, New Zealand},
	title = {Lithium-ion {Battery} {SOH} {Estimation} and {Fault} {Diagnosis} with {Missing} {Data}},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	isbn = {978-1-5386-3460-8},
	url = {https://ieeexplore.ieee.org/document/8826888/},
	doi = {10.1109/I2MTC.2019.8826888},
	abstract = {State-of-health (SOH) is an important index indicating the batterys energy storage performance and health condition. However, the volume of SOH is highly dependent on the batterys initial capacity rather than the current capacity. Consequently, it is intractable to infer the SOH of batteries with missing data. In this paper, we propose a dynamic Peukerts law-based battery SOH estimation method. The dynamic Peukerts law correlates capacity loss with Peukerts coefﬁcient, and eliminates the degradation inconsistency and is applicable for the same type of battery. Since the Peukerts coefﬁcient can be calculated by multi-discharging test, the SOH is able to be estimated directly, and therefore, the limitation of data missing is overcome.},
	language = {en},
	urldate = {2025-01-31},
	booktitle = {2019 {IEEE} {International} {Instrumentation} and {Measurement} {Technology} {Conference} ({I2MTC})},
	publisher = {IEEE},
	author = {Yang, Ang and Wang, Yu and Tsui, Kowk Leung and Zi, Yanyang},
	month = may,
	year = {2019},
	pages = {1--6},
}

@article{yangArrheniusEquationBasedCellHealth2013,
	title = {Arrhenius {Equation}-{Based} {Cell}-{Health} {Assessment}: {Application} to {Thermal} {Energy} {Management} {Design} of a {HEV} {NiMH} {Battery} {Pack}},
	volume = {6},
	copyright = {https://creativecommons.org/licenses/by/3.0/},
	issn = {1996-1073},
	shorttitle = {Arrhenius {Equation}-{Based} {Cell}-{Health} {Assessment}},
	url = {https://www.mdpi.com/1996-1073/6/5/2709},
	doi = {10.3390/en6052709},
	abstract = {This paper presents a model-based cell-health-conscious thermal energy management method. An Arrhenius equation-based mathematical model is firstly identified to quantify the effect of temperature on the cell lifetime of a Nickel Metal Hydride (NiMH) battery pack. The cell aging datasets collected under multiple ambient temperatures are applied to extract the Arrhenius equation parameters. The model is then used as an assessment criterion and guidance for the thermal management design of battery packs. The feasibility and applicability of a pack structure with its cooling system, is then evaluated, and its design problems are studied by a computational fluid dynamics (CFD) analysis. The performance and eligibility of the design method is validated by both CFD simulations and experiments.},
	language = {en},
	number = {5},
	urldate = {2025-01-31},
	journal = {Energies},
	author = {Yang, Yalian and Hu, Xiaosong and Qing, Datong and Chen, Fangyuan},
	month = may,
	year = {2013},
	pages = {2709--2725},
}

