@inproceedings{tiddensBusinessCaseConditionbased2017,
	address = {High Tatras Mountains, Tatranské Matliare, Slovak Republic},
	title = {The business case for condition-based maintenance: {A} hybrid (non-) financial approach},
	isbn = {978-1-138-62937-0 978-1-351-80973-3},
	shorttitle = {The business case for condition-based maintenance},
	url = {http://www.crcnetbase.com/doi/10.1201/9781315210469-107},
	doi = {10.1201/9781315210469-107},
	abstract = {Although developing business cases is key for evaluating project success, the costs and benefits of Condition-Based Maintenance (CBM) implementations are often not explicitly defined and evaluated. Using the design science methodology, we developed a hybrid business case approach to help managers evaluate and justify implementing CBM. We conclude that depending on the innovativeness (for the organization) of the applied technique, the business case should have a different goal orientation and be composed of different support elements. We use the proposed hybrid business case approach in an in-depth single case study that focusses on developing engine condition trend monitoring for a military transport aircraft. The case study explores differences in applying innovative maintenance techniques (exploration) or applying well-known techniques (exploitation). Using a combination of non-financial (strategic multi-criteria analysis) and financial elements (using Monte Carlo simulation), we compared the investment in CBM with both fixed-interval preventive maintenance and corrective maintenance.},
	language = {en},
	urldate = {2026-02-09},
	booktitle = {Safety and {Reliability} – {Theory} and {Applications}},
	publisher = {CRC Press},
	author = {Tiddens, W and Tinga, T and Braaksma, A and Brouwer, O},
	month = jun,
	year = {2017},
	pages = {126--126},
}

